generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Product {
  id          String      @id @default(uuid())
  name        String
  image       String?  
  imageData   Bytes?
  imageMimeType String?
  price       Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  attributes  ProductAttributeAssignment[]
  @@index([name])
}

model ProductAttribute {
  id          String      @id @default(uuid())
  name        String      @unique 
  values      ProductAttributeValue[]
}

model ProductAttributeValue {
  id          String      @id @default(uuid())
  value       String     
  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products    ProductAttributeAssignment[]

  @@unique([value, attributeId])
}

model ProductAttributeAssignment {
  id                 String               @id @default(uuid())
  productId          String
  attributeValueId   String
  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue     ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeValueId])
}
